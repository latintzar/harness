     "processor": {"script": "jobshop_trackers.delivery_estimate", "reads": ["jobs"], "summary": "script"},
     "canvas": {"family": "metric_history"}, "tile": {"family": "metric", "unit": "days"}, "requires": ["order_log"]}
  ],
  "needs": {"order_log": "Needs the order log"},
  "vocabulary": {
    "job_opened": {"label": "Job opened", "group": "shop_floor", "scope": "job"},
