{
  "business_type": "retail",
  "revision": "retail-core-v1",
  "playbook": "retail-v1",
  "layers": {
    "tracker": "The observed event stream of one kind for a location, per camera.",
    "processor": "The script that reads the stream with the catalog and sales, passes it through or computes, and writes one output revision. A Tracking Agent processor may wake its agent for a new summary edition; a Core Tracker computes its own.",
    "canvas": "The full view data of that revision.",
    "tile": "The compact summary of the same revision."
  },
  "trackers": [
    {
      "key": "visitors",
      "label": "Visitors",
      "interest": "visitors",
      "tracker": {
        "observes": "People seen by the location cameras, one session per tracked person.",
        "stream": "tracked_visits",
        "event_types": []
      },
      "processor": {
        "script": "core_trackers.visitors",
        "reads": [
          "tracked_visits",
          "events"
        ],
        "summary": "script"
      },
      "canvas": {
        "family": "metric_history"
      },
      "tile": {
        "family": "metric",
        "unit": "visitors"
      },
      "requires": [
        "camera",
        "person_tracking"
      ]
    },
    {
      "key": "product_interactions",
      "label": "Product interactions",
      "interest": "products",
      "tracker": {
        "observes": "Every time a visitor handles or examines a product.",
        "stream": "events",
        "event_types": [
          "pick_up",
          "pickup",
          "picked_up_item",
          "touch",
          "touch_product",
          "put_back",
          "put_back_item",
          "put_down",
          "place_in_basket",
          "examine_object",
          "examine_item",
          "inspect_product",
          "rotate_item",
          "hand_over",
          "carry",
          "drop_item",
          "conceal_item",
          "remove_packaging",
          "exit_with_item",
          "place_elsewhere"
        ]
      },
      "processor": {
        "script": "core_trackers.product_interactions",
        "reads": [
          "events",
          "observed_items",
          "catalog"
        ],
        "summary": "script"
      },
      "canvas": {
        "family": "ranking_product"
      },
      "tile": {
        "family": "metric",
        "unit": "interactions"
      },
      "requires": [
        "camera",
        "person_tracking"
      ]
    },
    {
      "key": "picked_up",
      "label": "Picked up",
      "interest": "products",
      "tracker": {
        "observes": "Products a visitor takes from a shelf.",
        "stream": "events",
        "event_types": [
          "pick_up",
          "pickup",
          "picked_up_item"
        ]
      },
      "processor": {
        "script": "core_trackers.picked_up",
        "reads": [
          "events",
          "observed_items",
          "catalog"
        ],
        "summary": "script"
      },
      "canvas": {
        "family": "occurrences"
      },
      "tile": {
        "family": "metric",
        "unit": "items"
      },
      "requires": [
        "camera",
        "person_tracking"
      ]
    },
    {
      "key": "put_back",
      "label": "Put back",
      "interest": "products",
      "tracker": {
        "observes": "Products a visitor returns to a shelf.",
        "stream": "events",
        "event_types": [
          "put_back",
          "put_back_item"
        ]
      },
      "processor": {
        "script": "core_trackers.put_back",
        "reads": [
          "events",
          "observed_items",
          "catalog"
        ],
        "summary": "script"
      },
      "canvas": {
        "family": "occurrences"
      },
      "tile": {
        "family": "metric",
        "unit": "items"
      },
      "requires": [
        "camera",
        "person_tracking"
      ]
    },
    {
      "key": "basket",
      "label": "Basket",
      "interest": "products",
      "tracker": {
        "observes": "What each visitor holds over time, valued with catalog prices.",
        "stream": "events",
        "event_types": [
          "pick_up",
          "pickup",
          "picked_up_item",
          "carry",
          "place_in_basket",
          "put_back",
          "put_back_item",
          "put_down",
          "place_elsewhere",
          "drop_item",
          "hand_over"
        ]
      },
      "processor": {
        "script": "core_trackers.basket",
        "reads": [
          "baskets",
          "catalog"
        ],
        "summary": "script"
      },
      "canvas": {
        "family": "metric_history"
      },
      "tile": {
        "family": "metric",
        "unit": "items"
      },
      "requires": [
        "camera",
        "person_tracking"
      ]
    },
    {
      "key": "queue_time",
      "label": "Queue time",
      "interest": "queues",
      "tracker": {
        "observes": "How long visitors wait from joining the queue to reaching the till.",
        "stream": "events",
        "event_types": [
          "entered_queue",
          "reached_checkout",
          "left_queue",
          "queue_exit"
        ]
      },
      "processor": {
        "script": "core_trackers.queue_time",
        "reads": [
          "queue_intervals"
        ],
        "summary": "script"
      },
      "canvas": {
        "family": "metric_history"
      },
      "tile": {
        "family": "metric",
        "unit": "s"
      },
      "requires": [
        "camera",
        "person_tracking",
        "queue_zone"
      ]
    },
    {
      "key": "empty_shelves",
      "label": "Empty shelves",
      "interest": "stock",
      "tracker": {
        "observes": "Shelves seen empty and when they are replenished.",
        "stream": "events",
        "event_types": [
          "display_empty",
          "out_of_stock",
          "stock_out",
          "restocked"
        ]
      },
      "processor": {
        "script": "core_trackers.empty_shelves",
        "reads": [
          "shelf_states"
        ],
        "summary": "script"
      },
      "canvas": {
        "family": "state_replenishment"
      },
      "tile": {
        "family": "state",
        "unit": "shelves"
      },
      "requires": [
        "camera",
        "shelf_zone"
      ]
    },
    {
      "key": "sales",
      "label": "Sales",
      "interest": "payment_actions",
      "tracker": {
        "observes": "Transactions and their lines, from the till or estimated from baskets.",
        "stream": "sales",
        "event_types": []
      },
      "processor": {
        "script": "core_trackers.sales",
        "reads": [
          "sales",
          "catalog"
        ],
        "summary": "script"
      },
      "canvas": {
        "family": "metric_history"
      },
      "tile": {
        "family": "metric",
        "unit": ""
      },
      "requires": [
        "sales"
      ]
    },
    {
      "key": "conversion",
      "label": "Conversion",
      "interest": "visitors",
      "tracker": {
        "observes": "The share of visitors who buy.",
        "stream": "sales",
        "event_types": []
      },
      "processor": {
        "script": "core_trackers.conversion",
        "reads": [
          "tracked_visits",
          "sales"
        ],
        "summary": "script"
      },
      "canvas": {
        "family": "metric_history"
      },
      "tile": {
        "family": "metric",
        "unit": "%"
      },
      "requires": [
        "camera",
        "person_tracking",
        "sales"
      ]
    }
  ],
