# Retail vertical settings. Apply with the shared ../../.env.example.
# New names take precedence; retail_settings.py retains the installed legacy aliases.
# Explicit empty values override legacy values. Commission secrets in private host configuration.

# Optional maintained read integration for the existing video product.
# legacy preserves the current reader; maintained selects the shared PostgreSQL SDK.
# Commission exact workspace/principal/source identities before selecting maintained.
# Selection is fixed at service startup. Read failures retain the chosen authority.
# This selects reads only; existing write and scheduler commissioning is separate.
ROCOTO_RETAIL_REALTIME_READS=legacy

# Existing maintained runtime connection contract: exact rocoto_rt role, FORCE RLS.
# Supply the company-owned service secret through the declared runtime environment file.
RUNTIME_DATABASE_URL=

# Weather and the neighbourhood map of a location (location_context.py). on: this service calls
# Open-Meteo and the OpenStreetMap tile server with the shop's coordinates, inside the daily caps in
# docs/COST-SAFETY.md. off: every outside call stops and saved answers stay in service.
ROCOTO_RETAIL_LOCATION_CONTEXT=on

# The commissioned map provider for the neighbourhood picture (location_context.py). Mapbox draws it
# when its token is set, Google when its key is set; with both empty the OpenStreetMap tiles draw it.
# One call per picture shape, kept as long as the provider says it is valid; 60 calls per UTC day
# and 1,000 per UTC month for this host's user, counted in the ledger that
# `python location_context.py commission-map-ledger` makes. Supply the company-owned key through
# the declared runtime environment file; the service reads it once and takes it out of its environment.
ROCOTO_RETAIL_MAPBOX_TOKEN=
ROCOTO_RETAIL_GOOGLE_MAPS_API_KEY=

# Trackers run by themselves (tracker_runner.py). on: every five seconds the service looks at each
# location with installed trackers and runs one deterministic pass when its inputs changed, when its
# local day turned or when a run was requested. One pass per location at a time, 60 seconds between
# passes by default, 60 seconds of time budget per pass. A pass computes from saved observations
# alone, free of model and provider calls. off: every pass of the service stops and the host
# commands in DEMO-SEED.md run one on request.
ROCOTO_TILE_RUNNER=on

# Script runs on new events (tracker_scripts.py), and the operator's statement that the broker's
# retention upgrade is installed (deploy/native-executor/UPGRADE-CUSTOM-RETENTION.md). off: the
# installed broker keeps every job row and stops taking jobs at 2,048 for the whole host, so a
# tracker's processing script runs once for each local day of its location, on request and on a
# test, inside 8 sandbox jobs per tracker and UTC day, 24 per company and 48 for the host in any 24
# hours, and 1,024 for the host in all. on: it also runs in the passes new events start, inside
# 480 jobs per tracker and UTC day, 600 per company and 1,200 for the host in any 24 hours. The
# host's count of script jobs is kept in tracker-script-jobs.sqlite in the service's state root.
ROCOTO_TILE_SCRIPT_EVENT_RUNS=off

# Optional inspection services: enable only for commissioned workspace ids and funded providers.
ROCOTO_RETAIL_ITEM_INSPECTION_ENABLED=
ROCOTO_RETAIL_ITEM_INSPECTION_WORKSPACES=
ROCOTO_RETAIL_SHELF_CATALOG_INSPECTION_ENABLED=
ROCOTO_RETAIL_SHELF_CATALOG_WORKSPACES=

# Optional source derivatives and the configured legacy archive reader.
ROCOTO_RETAIL_SOURCE_DERIVATIVES_ENABLED=
# ROCOTO_RETAIL_QDRANT_URL=http://127.0.0.1:6333

# Company-owned Modal execution paths. Set both when commissioning that provider.
# ROCOTO_RETAIL_MODAL_PYTHON=/path/to/commissioned/python
# ROCOTO_RETAIL_MODAL_CONFIG_PATH=/path/to/private/modal.toml

# Script execution also requires the shared ROCOTO_CUSTOM_EXECUTOR_ENABLED commissioning switch.
