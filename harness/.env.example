# Shared Rocoto harness settings. Load through the owning service's private environment.
# OpenAI runs the agent core through the managed Agents API with hosted execution.
# The vertical's .env.example declares its additional business-specific settings.
ROCOTO_VERTICAL=bare
# Set your own exact HTTPS origin for hosted managed execution.
ROCOTO_PUBLIC_ORIGIN=
ROCOTO_STATE_DIRECTORY=/absolute/private/agent-workspace
ROCOTO_OPERATOR_NAME=Workspace owner
ROCOTO_OPERATOR_ID=workspace-owner
ROCOTO_BROWSE_SESSIONS=0

# Supply your own Platform project key through private server environment configuration.
# Agent execution also requires a funded workspace allowance and a recorded spending grant.
# enforced requires OpenAI session-budget access. monitored requires recorded overshoot approval.
ROCOTO_MANAGED_SPENDING_MODE=enforced
ROCOTO_AGENT_AUTH_MODE=openai_api
ROCOTO_OPENAI_API_KEY=

# Optional built-in channels. The selected vertical declares which channels it uses.
# These are paths to private provider/account configuration and finite spending grants.
ROCOTO_MESSAGING_CONFIG=
ROCOTO_PHONE_SPEND_CONFIG=
ROCOTO_CAPABILITY_SPEND_CONFIG=

# Optional commissioned connection writes and bounded custom connector/display jobs.
# The custom executor is Rocoto's code-job sandbox; OpenAI hosts the agent core.
ROCOTO_CONNECTION_WRITE_PROVIDERS=
ROCOTO_CUSTOM_EXECUTOR_ENABLED=0

# Shared display scheduling, enabled by a vertical's host implementation.
ROCOTO_TILE_RUNNER=on
ROCOTO_TILE_SCRIPT_EVENT_RUNS=off

# Optional commissioned document preview worker and its reviewed receipt.
ROCOTO_DOCUMENT_PREVIEWS_ENABLED=0
ROCOTO_DOCUMENT_PREVIEW_RECEIPT_SHA256=

# A state directory retains its original vertical in .workspace-template.json.
# The persisted name remains compatible with earlier releases and rollback.
